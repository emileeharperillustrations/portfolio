---
import MainLayout from "@layouts/MainLayout.astro";
import Container from "@components/layout/Container.astro";
import { Image } from "astro:assets";

import { getCollection } from "astro:content";
const portfolio = await getCollection("portfolio");
---

<style>
  .artwork {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 13 / 17;
    object-fit: cover;
    object-position: center;
  }

  .art-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(var(--min-art-width), 1fr));
    gap: 1rem;
  }

  .hero {
    display: none;
    position: relative;
  }

  .desktop-title {
    display: none;
    position: relative;
  }

  @media (width >= 65rem) {
    .hero {
      display: flex;
      width: 100%;
      height: auto;
      aspect-ratio: 24 / 9;
      background-image: url("https://placehold.co/1920x1080");
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      justify-content: center;
      align-items: center;
    }

    .desktop-title {
      display: block;
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      padding-top: 0.5rem;
    }

    .inner-desktop-title {
      background-color: black;
      padding: 0.25rem 1.1rem;
      border-radius: 21px;

      max-width: fit-content;
      margin: auto;
    }
  }
</style>

<MainLayout title="Portfolio" currentPage="portfolio">
  <div id="hero" class="hero">
    <div class="bg-img"></div>
  </div>
  <div id="desktop-title" data-sticky-title="true" class="desktop-title title">
    <div id="inner-desktop-title" class="inner-desktop-title">
      Emilee Harper
    </div>
  </div>
  <Container size="lg">
    <div class="art-grid">
      {
        portfolio
          .sort(
            (a, b) =>
              new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
          )
          .map((artwork) => (
            <Image
              src={artwork.data.image}
              layout="full-width"
              alt={artwork.data.alt}
              class="artwork"
            />
          ))
      }
    </div>
  </Container>
</MainLayout>
