---
import MainLayout from "@layouts/MainLayout.astro";
import Input from "@components/form/Input.astro";
import TextArea from "@/components/form/TextArea.astro";
import Button from "@/components/form/Button.astro";
import Container from "@/components/layout/Container.astro";
---

<MainLayout title="Contact Me" currentPage="contact">
  <div id="desktop-title" class="desktop-title title">Emilee Harper</div>
  <Container size="sm">
    <h2>Contact</h2>

    <form
      id="contact-form"
      action="https://api.web3forms.com/submit"
      method="POST"
    >
      <input
        type="hidden"
        name="access_key"
        value="0f59b768-0537-49bf-ab50-c74cf19905a6"
      />
      <input
        type="hidden"
        name="subject"
        value="New Submission from Contact Me Form"
      />
      <input
        type="hidden"
        name="redirect"
        value="https://foopis23.github.io/emilee-harper-portfolio/success"
      />
      <Input
        id="name"
        name="name"
        type="text"
        placeholder="John Doe"
        label="Name"
        required
      />
      <Input
        id="email"
        name="email"
        type="email"
        placeholder="johndoe@example.com"
        label="Email"
        required
      />
      <TextArea
        id="message"
        name="message"
        placeholder="Hello, I'm reaching out to you because..."
        required
        label="Message"
      />
      <div
        id="h-captcha"
        class="h-captcha"
        data-captcha="true"
        data-theme="dark"
        data-callback="showSubmitButton"
      >
      </div>

      <Button id="contact-form-submit">Submit</Button>
    </form>
  </Container>
</MainLayout>
