---
import { Image } from "astro:assets";
import MainLayout from "@layouts/MainLayout.astro";
import Container from "@components/layout/Container.astro";
import EmileeHarperPng from "@assets/emilee-harper.png";
---

<style>
  h2 {
    text-align: center;
  }

  p {
    text-align: center;
  }

  img {
    margin: auto;
  }

  a {
    color: var(--color-primary);
  }
</style>

<MainLayout title="About" currentPage="about">
  <div id="desktop-title" class="desktop-title title">Emilee Harper</div>
  <Container>
    <Image
      src={EmileeHarperPng}
      alt=""
      width={300}
      height={300}
      layout="fixed"
      class="circle"
    />
  </Container>
  <Container>
    <h2>About Emilee</h2>
    <p>
      Emilee Harper is a freelance illustrator based in Asheville, North
      Carolina. Semi-realism, abstract linework, and pops of color are what make
      her art eye catching. She has done work for her local game store, Gamers'
      Haunt, since 2022, decorating the same golden frame with Magic the
      Gathering inspired illustrations.
    </p>
    <p>
      For commissions or freelance inquires, please&nbsp;
      <a href="/emilee-harper-portfolio/contact">contact me</a>.
    </p>
  </Container>
</MainLayout>
