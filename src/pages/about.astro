---
import MainLayout from "@layouts/MainLayout.astro";
import Container from "@components/layout/Container.astro";
---

<MainLayout currentPage="about">
  <Container>
    <p>
      Emilee Harper is a freelance illustrator based in Asheville, North
      Carolina. Semi-realism, abstract linework, and pops of color are what make
      her art eye catching. She has done work for her local game store, Gamers'
      Haunt, since 2022, decorating the same golden frame with Magic the
      Gathering inspired illustrations.
    </p>
    <p>
      For commissions or freelance inquires, please <a href="/contact"
        >contact me</a
      >.
    </p>
  </Container>
</MainLayout>
