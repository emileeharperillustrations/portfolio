---
import NavChip from "./NavChip.astro";
import { Brush, SquareUser, MessageSquare } from "@lucide/astro";
---

<style>
  header {
    position: fixed;
    top: 0;
    height: var(--header-height);
    width: 100%;
    background-color: var(--color-header-background);
    border-bottom: 1px solid var(--color-header-border);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 5;
  }

  .desktop-nav {
    display: none;
  }

  @media (width >= 65rem) {
    header {
      display: none;
    }

    .desktop-nav {
      display: flex;
      flex-direction: column;
      position: fixed;
      top: 0.5rem;
      right: 0.5rem;
      z-index: 50;
      gap: 0.5rem;
      align-items: flex-end;
    }
  }
</style>
<>
  <header>
    <span class="title">Emilee Harper</span>
  </header>
  <nav class="desktop-nav" hx-boost="true">
    <NavChip href="/emilee-harper-portfolio">
      <Brush slot="icon" />
      Portfolio
    </NavChip>
    <NavChip href="/emilee-harper-portfolio/about">
      <SquareUser slot="icon" />
      About Me
    </NavChip>
    <NavChip href="/emilee-harper-portfolio/contact">
      <MessageSquare slot="icon" />
      Contact
    </NavChip>
  </nav>
</>
