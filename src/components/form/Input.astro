---
import "./form.css";
import type { HTMLAttributes } from "astro/types";
import FieldContainer from "@components/form/layout/FieldContainer.astro";

interface Props extends HTMLAttributes<"input"> {
  label?: String;
}
const { label: labelText, ...attrs } = Astro.props;
---

<FieldContainer>
  <label for={attrs.id ?? ""}>{labelText}</label>
  <input {...attrs} />
</FieldContainer>
