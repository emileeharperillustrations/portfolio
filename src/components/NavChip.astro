---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"a"> {}

const { ...attrs } = Astro.props;
---

<style>
  .nav-chip {
    display: flex;
    min-width: 133px;
    justify-content: right;
  }

  .nav-chip .chip {
    display: flex;
    align-items: center;
    justify-items: center;
    background-color: var(--color-primary);
    color: var(--color-primary-foreground);
    padding: 0.4rem;
    width: fit-content;
    border-radius: 13px;
  }

  .chip-text {
    overflow: hidden;
    width: 0;
    line-height: 1;
    transition: all 250ms;
    text-wrap: nowrap;
  }

  .nav-chip:hover .chip-text,
  .nav-chip[data-expanded="true"] .chip-text {
    display: block;
    width: fit-content;
    margin-left: 0.25rem;
  }
</style>

<a
  {...attrs}
  data-expanded="true"
  class="nav-chip copperplate"
  href="/emilee-harper-portfolio"
>
  <span class="chip">
    <slot name="icon" />
    <span class="chip-text"><slot /></span>
  </span>
</a>
